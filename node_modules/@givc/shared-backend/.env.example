# Server
PORT=3001
NODE_ENV=development
DEV_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PROD_CORS_ORIGINS=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=rcm
DB_USER=postgres
DB_PASSWORD=postgres
DB_NPHIES=

# JWT
ACCESS_TOKEN_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=8h
AUTH_PERIORITY=local # or ldap

# LDAP
LDAP_URL=ldap://128.1.1.99:389
LDAP_BIND_USERNAME=appdeveloper
LDAP_BIND_PASSWORD=change_me
LDAP_BIND_DN=hnhriyadh
LDAP_SEARCH_BASE=DC=hnhriyadh,DC=com
LDAP_GROUP_SEARCH_BASE=OU=HNH-Users,DC=hnhriyadh,DC=com
LDAP_USER_FILTER=(sAMAccountName={{username}})
LDAP_GROUP_FILTER=(objectClass=group)
LDAP_GROUP_ATTRIBUTE=member

# SMTP (optional, used elsewhere but included for completeness)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
