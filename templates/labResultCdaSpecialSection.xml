<component>
	<section>
		<templateId root="2.16.840.1.113883.3.3731.1.105.8" />
		<templateId root="1.3.6.1.4.1.19376.1.3.3.2.1" />
		<code code="{{DATA.DEPT_LOINC_CODE}}"
			  codeSystem="2.16.840.1.113883.6.1"
			  codeSystemName="LOINC"
			  displayName="{{DATA.DEPT_LOINC_NAME}}" />
		<title>{{DATA.DEPT_LOINC_NAME}}</title>
		<!-- human readable -->
		<text>
			<paragraph styleCode="Bold">Specimen</paragraph>
            <br />
            <list>
				<item ID="specimen1-collectiontime">Collection Time:{{DATA.SPECIMEN_COLLECTION_TIME_HUMAN_READABLE}}</item>
				 {{DATA.SPECIMEN_TYPE_TAG}}
				<item ID="specimen1-source" />
				<item ID="specimen1-collectionmethod" />
				<item ID="specimen1-handling" />
				<item ID="specimen1-risk" />
				<item ID="specimen1-riskcomment" />
			</list>
            <br />
            <paragraph styleCode="Bold">Laboratory Result</paragraph>

            <br />Battery: <content ID="battery1-code">{{DATA.BATTERY_CODE}}, {{DATA.BATTERY_DESCRIPTION}}</content>
            <table>
				<colgroup>
					<col width="25%" />
					<col width="15%" />
					<col width="15%" />
					<col width="15%" />
					<col width="15%" />
				</colgroup>
				<thead>
					<tr>
						<th>Date</th>
						<th>Description</th>
						<th>Value</th>
						<th>Range</th>
						<th>Interpretation</th>
					</tr>
				</thead>
				<tbody> {{DATA.LAB_RESULTS_HUMAN}} </tbody>
			</table>
		</text>
		<!-- machine readable -->
		<entry typeCode="DRIV">
			<templateId root="2.16.840.1.113883.3.3731.1.105.9" />
			<templateId root="1.3.6.1.4.1.19376.1.3.1" />
			<act classCode="ACT"
				 moodCode="EVN">
				<code code="{{DATA.DEPT_LOINC_CODE}}"
					  codeSystem="2.16.840.1.113883.6.1"
					  codeSystemName="LOINC"
					  displayName="{{DATA.DEPT_LOINC_NAME}}" />
				<statusCode code="{{DATA.LAB_STATUS}}" />
				<entryRelationship typeCode="COMP">
					<organizer classCode="BATTERY"
							   moodCode="EVN">
						<templateId root="2.16.840.1.113883.3.3731.1.105.15" />
						<templateId root="1.3.6.1.4.1.19376.1.3.1.4" />
						<code code="{{DATA.BATTERY_CODE}}"
							  codeSystem="2.16.840.1.113883.6.1"
							  displayName="{{DATA.BATTERY_DESCRIPTION}}">
							<originalText>
								<reference value="#battery1-code" />
							</originalText>
						</code>
						<statusCode code="{{DATA.LAB_STATUS}}" />
						<effectiveTime value="{{DATA.ORDER_EFFECTIVE_LOW}}" /> {{DATA.LAB_RESULTS_MACHINE}} </organizer>
				</entryRelationship>
			</act>
		</entry>
		<entry typeCode="DRIV">
			<templateId root="2.16.840.1.113883.3.3731.1.105.3" />
			<act classCode="ACT"
				 moodCode="RQO">
				<code code="{{DATA.DEPT_LOINC_CODE}}"
					  codeSystem="2.16.840.1.113883.6.1"
					  codeSystemName="LOINC"
					  displayName="{{DATA.DEPT_LOINC_NAME}}">
					<originalText>
						<reference value="#order_test_1_1-code" />
					</originalText>
				</code>
				<!-- TODO: priority status code  -->
				<priorityCode code="R"
							  codeSystem="2.16.840.1.113883.5.7"
							  displayName="Routine, within 48 hours of order">
					<originalText>
						<reference value="#order_test_1_1-prioritycode" />
					</originalText>
				</priorityCode>
			</act>
		</entry>
	</section>
</component>